# ===========================
# Multi-LLM configuration
# ===========================
# Choose provider: gemini | openai | anthropic | openai-compatible | bedrock | groq
LLM_PROVIDER=gemini

# Model name depends on provider.
# - gemini: e.g. gemini-2.5-flash, gemini-2.5-pro, ...
# - openai: e.g. gpt-4o-mini, gpt-4.1-mini, ...
# - anthropic: e.g. claude-3-5-sonnet-latest, ...
# - openai-compatible: your server model id
LLM_MODEL=gemini-3.1-flash-lite-preview

# Common tuning
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# Keys (use either the generic LLM_API_KEY or provider-specific keys)
LLM_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# AWS Bedrock credentials (not needed if using IAM role / aws configure)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=       # only for temporary credentials / SSO
AWS_REGION=us-east-1

# For self-host / OpenAI-compatible servers (vLLM/TGI/llama.cpp server)
LLM_BASE_URL=http://localhost:8000/v1

# Agent API listener
APP_URL=http://localhost:8001
SERVER_HOST=0.0.0.0
SERVER_PORT=8001
SERVER_CONTEXT_PATH=/api

# ===========================
# Web Search Config
# ===========================
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_MAX_RETRIES=2
WEB_SEARCH_RETRY_BACKOFF_SECONDS=1.0
TAVILY_API_KEY=

# Optional: corporate/office proxy for outbound HTTPS requests (e.g. Tavily)
# Leave blank if no proxy is needed.
WEB_SEARCH_HTTP_PROXY=
WEB_SEARCH_HTTPS_PROXY=

# ===========================
# PostgreSQL — Conversation Memory (LangGraph PostgresSaver)
# DB_POSTGRES_URL: native postgresql:// URL (nếu set thì ưu tiên dùng, bỏ qua các field bên dưới)
# ===========================
DB_POSTGRES_URL=
DB_POSTGRES_HOST=localhost
DB_POSTGRES_PORT=5432
DB_POSTGRES_DATABASE=postgres
DB_POSTGRES_USERNAME=VNBank
DB_POSTGRES_PASSWORD=VNBank2024!

# ===========================
# MCP Server — Banking Tools
# URL tới Banking MCP Server (chạy riêng, default port 8001)
# Nếu MCP server offline, rag_agent tự fallback về search_vectordb only.
# ===========================
MCP_SERVER_URL=http://host.docker.internal:8003/mcp

# ===========================
# RAG Service — client (app/ gọi sang rag_service qua HTTP)
#
# app/ không mở vector store hay embedding model nào. Toàn bộ retrieval và
# ingestion thuộc về rag_service (chạy riêng, xem rag_service/README.md).
# ===========================
RAG_CLIENT_SERVICE_URL=http://host.docker.internal:8002
RAG_CLIENT_CONTEXT_PATH=/api/v1
RAG_CLIENT_TIMEOUT=10.0
RAG_CLIENT_MAX_RETRIES=1

# RAG server có config độc lập tại rag_service/.env.example.
